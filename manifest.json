{
  "manifest_version": 3,
  "name": "درع فطن — حماية التصفح",
  "version": "1.0.0",
  "description": "يفحص مؤشرات الاشتباه في عناوين المواقع ويشرحها بالعربية. لا يمثل فحصًا مضادًا للفيروسات.",
  "permissions": ["storage", "tabs"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "درع فطن"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}]
}
