{
  "manifest_version": 3,
  "name": "درع فطن | حماية التصفح",
  "version": "1.1.0",
  "description": "تنبيه محلي عند اجتماع انتحال جهة مع طلب بيانات دخول أو دفع، دون قراءة قيم الحقول.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_title": "درع فطن: تفعيل الحماية",
    "default_popup": "popup.html",
    "default_icon": {
      "192": "icons/fatin-192.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://abdullatifmoh.github.io/fatin/*",
        "https://fatin.onrender.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "192": "icons/fatin-192.png",
    "128": "icons/fatin-128.png",
    "48": "icons/fatin-48.png"
  }
}
